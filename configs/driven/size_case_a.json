{
  "case": "size_case_a",
  "model": {
    "N": 8,
    "a": 1.0,
    "m": 1.0,
    "g": 1.0,
    "Q": 0,
    "boundary": "open"
  },
  "initial_state": "exact_neutral_zero_field_ground_state",
  "pulse": {
    "kind": "two_sauter",
    "epsilon_s": 1.0,
    "T_s": 10.0,
    "epsilon_w": 0.01,
    "tau": 0.5,
    "t_d": 0.0,
    "tail_relative_threshold": 0.0001,
    "taper_duration_in_component_widths": 1.0
  },
  "integrator": {
    "method": "DOP853",
    "rtol": 1e-10,
    "atol": 1e-12,
    "max_step": 0.05
  },
  "readout": {
    "endpoint": "pulse_end",
    "post_pulse_duration": 10.0,
    "sampling_interval": 0.1
  },
  "seed": null,
  "scan": {
    "model.N": [
      8,
      12,
      16
    ],
    "pulse.tau": [
      0.2,
      0.5,
      1.0
    ]
  },
  "analysis": {
    "convergence": true,
    "spectral_convergence": true,
    "lanczos_steps": 64,
    "comparison": "fixed a,g and pulse parameters; calibrated strong background epsilon_s=1"
  }
}
